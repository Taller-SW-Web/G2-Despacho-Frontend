{
  "name": "despacho-frontend",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:administrativo": "npm run dev -w @despacho/administrativo",
    "dev:repartidor": "npm run dev -w @despacho/repartidor",
    "build": "npm run build -w @despacho/administrativo && npm run build -w @despacho/repartidor",
    "typecheck": "npm run typecheck -w @despacho/componentes-compartidos && npm run typecheck -w @despacho/administrativo && npm run typecheck -w @despacho/repartidor",
    "test": "npm run test -w @despacho/componentes-compartidos",
    "test:administrativo": "npm run test -w @despacho/administrativo",
    "test:f04": "npm run test -w @despacho/administrativo -- src/features/entregas-fallidas src/sesion",
    "test:f05": "npm run test -w @despacho/administrativo -- src/features/flota",
    "test:watch": "npm run test:watch -w @despacho/componentes-compartidos"
  },
  "engines": { "node": ">=20", "npm": ">=10" }
}
