# Configuración local de la app del repartidor. Todas las variables VITE_* son públicas.

# ==================== API Gateway ====================

# Origen del API Gateway, sin /api/v1. En Vercel usar el origen HTTPS del ambiente.
VITE_API_BASE_URL=http://localhost:8080

# ==================== Acceso y Seguridad ====================

# Origen para login, OTP, renovación y perfil. Vacío usa el Gateway. Para G7 directo usar su origen sin /api/v1 y habilitar CORS.
VITE_SEGURIDAD_URL=
# Activa el flujo del emisor temporal en desarrollo fuera del modo demo. Usar false al conectar G7.
VITE_SEGURIDAD_LOCAL=true

# ==================== Opciones de desarrollo ====================

# Activa la demo del repartidor con datos en memoria, solo en desarrollo. Usar false para Operación real.
VITE_MODO_DEMO=false
