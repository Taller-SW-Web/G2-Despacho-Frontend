# true: datos y operaciones en memoria, sin backend. Solo para revisar la interfaz.
VITE_MODO_DEMO=false
# Tipo de la jornada de demostración: ENTREGAS o RECOJOS.
VITE_DEMO_TIPO_JORNADA=ENTREGAS
