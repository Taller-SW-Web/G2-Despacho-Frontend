VITE_API_BASE_URL=http://localhost:8080

# Origen sin /api/v1. Vacío usa Gateway para login, OTP, refresh, logout y perfil.
# Confirmar ambiente y CORS con G7 antes de usar cuentas reales.
VITE_SEGURIDAD_URL=
