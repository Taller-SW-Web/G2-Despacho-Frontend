VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_SIN_AUTENTICACION=false

# Vacío: acceso humano por Gateway. Para G7 directo: origen HTTPS, sin /api/v1.
# Confirmar ambiente y CORS con G7 antes de usar cuentas reales.
VITE_SEGURIDAD_URL=
# Solo desarrollo: muestra el buzón OTP del emisor local (proxy Vite a 8090).
# Cambiar a false al conectar G7, incluso en desarrollo.
VITE_SEGURIDAD_LOCAL=true

# Solo para desarrollo local: JWT humano con rol GESTOR_DESPACHO.
# Se usa mientras el módulo Seguridad y Usuarios no exponga el flujo de acceso.
# No guardar secretos reales en variables VITE_*.
VITE_DEV_TOKEN=
