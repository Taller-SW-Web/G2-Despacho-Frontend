# Configuración local de la app administrativa. Todas las variables VITE_* son públicas.

# ==================== API Gateway ====================

# Origen del API Gateway, sin /api/v1. En Vercel usar el origen HTTPS del ambiente.
VITE_API_BASE_URL=http://localhost:8080

# ==================== Acceso y Seguridad ====================

# Origen para login, OTP, renovación y perfil. Vacío usa el Gateway. Para G7 directo usar su origen sin /api/v1 y habilitar CORS.
VITE_SEGURIDAD_URL=
# Activa el buzón OTP del emisor temporal en desarrollo. Usar false al conectar G7.
VITE_SEGURIDAD_LOCAL=true

# ==================== Opciones de desarrollo ====================

# En desarrollo, omite la autenticación del frontend para la demo. Mantener false al usar el backend protegido.
VITE_DEMO_SIN_AUTENTICACION=false
# JWT humano ficticio para desarrollo con rol GESTOR_DESPACHO. Dejar vacío en Vercel.
VITE_DEV_TOKEN=
